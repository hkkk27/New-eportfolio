# Copy this file to .env and fill in what you need. .env is never uploaded.

# Optional. Without a key the script still works, using only what it can read directly from the page.
OPENROUTER_API_KEY=

# Optional. Leave empty to let the script pick a free model.
OPENROUTER_MODEL=

# Your faculty list, used by: python profpages.py add --email someone@university.edu
FACULTY_CSV=D:\fun projects\university_faculty_directory.csv

# The Vercel project name. It decides the web address.
VERCEL_PROJECT=faculty-pages
